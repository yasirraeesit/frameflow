{
  "name": "frameflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "shared",
    "server/*"
  ],
  "scripts": {
    "dev:client": "npm --workspace=@frameflow/web run dev",
    "dev:api": "npm --workspace=@frameflow/api run dev",
    "dev:worker": "npm --workspace=@frameflow/worker run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
