# PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/frameflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_RAW="raw-assets"
S3_BUCKET_PROXIES="proxies"
S3_BUCKET_THUMBNAILS="thumbnails"
S3_BUCKET_RENDERS="renders"
S3_FORCE_PATH_STYLE="true"

# JWT
JWT_SECRET="frameflow-super-secret-jwt-key-2026-production-grade"

# Server Ports
PORT=4000
HOST="0.0.0.0"
WEB_URL="http://localhost:3000"

# AI Provider (for Phase 4-5)
GEMINI_API_KEY=""

